# ──────────────────────────────────────────────────────────────────────────────
# Dewoc — Admin Comercio · Variables de entorno
# Copiá este archivo a .env y completá los valores para tu entorno.
# El archivo .env está en .gitignore — nunca lo subas al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=development     # development | production
APP_URL=http://localhost/01-Dewoc-Sist-Admin-Comercio

# ── Datos del comercio (encabezado de tickets y comandas) ───────────────────
NEGOCIO_NOMBRE=Serendipia
NEGOCIO_DIRECCION=Lapida 1026, Ezeiza, Bs. As.

# ── Impresora térmica (ticket/comanda) ──────────────────────────────────────
# Ancho real del rollo de papel en mm. Comunes: 50, 58, 80, 100.
TICKET_ANCHO_MM=50
# Zoom general del texto impreso (100 = normal, 130 = 30% más grande). Subilo si
# no se lee bien impreso; no hace falta tocar ninguna vista, solo este valor.
TICKET_ZOOM_PCT=130

# ── Datos fiscales del comercio (encabezado del comprobante ARCA/AFIP) ──────
# Condición del NEGOCIO frente al IVA — determina si se discrimina IVA en el
# POS/venta y qué tipo de comprobante se pide a AFIP (ver AFIP_TIPO_CBTE abajo).
# Valores: monotributista | responsable_inscripto | exento
NEGOCIO_CONDICION_IVA=monotributista
# Ingresos Brutos (vacío = no se imprime la línea en el ticket)
NEGOCIO_IIBB=
# Formato dd/mm/YYYY (vacío = no se imprime la línea en el ticket)
NEGOCIO_INICIO_ACTIVIDADES=
# Texto libre del encabezado fiscal del ticket; si se deja vacío se arma
# automáticamente a partir de NEGOCIO_CONDICION_IVA.
NEGOCIO_CONDICION_FISCAL=
NEGOCIO_ORIENTACION_CONSUMIDOR=Orientación al Consumidor Provincia de Buenos Aires 0800-222-9042

# ── Base de datos ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=u374453216_erp_comercio
DB_USER=root
DB_PASS=

# ── Mercado Pago ─────────────────────────────────────────────────────────────
# Obtené tus credenciales en https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ── Chat IA (Google Gemini) ───────────────────────────────────────────────────
# Obtené tu API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cadena de modelos de respaldo si GEMINI_MODEL agota su cuota (RPM/RPD), separados
# por coma y en el orden en que se prueban — dejar vacío para desactivar. Ver el ID
# exacto de cada uno en "Límite de frecuencia" dentro de Google AI Studio.
# Ejemplo: GEMINI_MODEL_FALLBACK=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Opcional: API key de una cuenta CON facturación habilitada (tokens de pago). Si se
# completa, el chat la usa como último recurso SOLO cuando GEMINI_API_KEY (gratis) devuelve
# 429 "cupo agotado" en todos los modelos de la cadena de arriba — nunca para otro tipo de
# error. Dejar vacío para no usar ningún respaldo de pago (se corta con el error de siempre
# cuando se agota el free).
GEMINI_API_KEY_PAGO=


# ── Galería: generación/edición de imagen y video (Gemini/Veo) ──────────────
# API key A PROPÓSITO SEPARADA de GEMINI_API_KEY: el chat de texto vive tranquilo
# en el tier gratis, mientras que imagen/video necesitan un proyecto de Google
# con facturación habilitada — usar una key de un proyecto distinto (o del mismo
# proyecto de Google Cloud pero facturado aparte) para no mezclar el consumo
# pago de la Galería con el uso gratuito del chat general.
GEMINI_MEDIA_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# ── Galería: proveedor alternativo gratis/más económico (NVIDIA NIM) ────────
# Registrate en https://build.nvidia.com para obtener la API key. Verificá el
# slug exacto del modelo en la pestaña "Deploy"/API de cada modelo elegido.
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=qwen/qwen-image
NVIDIA_VIDEO_MODEL=wan/wan2.1-i2v-14b

# ── Chat IA (Anthropic Claude) — alias legado, no se usa en el código actual ─
CLAUDE_API_KEY=

# ── SECRETOS ────────────────────────────────────────────────────────────────
# Los tres de abajo NO tienen valor por defecto en el código: si los dejás vacíos, la
# funcionalidad que depende de cada uno queda apagada (no se cae a un valor conocido,
# que sería adivinable por cualquiera que mire el repositorio). Hay que cargarlos en el
# .env de cada instalación.

# Web Push (notificaciones de solicitudes a administradores).
# Generar una sola vez con WebPush::generarClavesVapid() y no volver a cambiarlas
# (todas las suscripciones de los navegadores quedarían inválidas).
# Vacío → no se envían notificaciones push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@tudominio.com

# ── Cron jobs (tareas programadas) ───────────────────────────────────────────
# Token para autorizar los scripts de /cron/ si el hosting solo permite disparar
# por URL en vez de ejecutar el script PHP directo por CLI.
# Vacío → los scripts de /cron/ rechazan las llamadas por HTTP (403). Por CLI andan igual.
# Generar con: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET=

# Firma los links de ticket compartidos por WhatsApp/email (para que el cliente
# pueda verlo sin tener una sesión iniciada).
# Vacío → los links de ticket compartidos no validan y el cliente ve la pantalla de login.
# Generar con: php -r "echo bin2hex(random_bytes(32));"
TICKET_SHARE_SECRET=

# ── AFIP (Facturación electrónica) ───────────────────────────────────────────
# AFIP_MODO: 'homo' para pruebas con homologación, 'prod' para producción
AFIP_MODO=homo
# CUIT del emisor (sin guiones, 11 dígitos)
AFIP_CUIT=23312398729
# Rutas al certificado y clave privada PEM (descargados desde AFIP)
AFIP_CERT=storage/afip/cert.pem
AFIP_KEY=storage/afip/key.pem
AFIP_KEY_PASS=
# Punto de venta registrado en AFIP (número sin ceros a la izquierda)
AFIP_PTO_VENTA=3
# El tipo de comprobante (Factura A/B/C) ya no se configura acá: se calcula
# automáticamente por venta según NEGOCIO_CONDICION_IVA y la condición IVA
# del cliente (AfipWsfe::tipoComprobante()).

# ── Email ────────────────────────────────────────────────────────────────────
# Requiere un MTA configurado (sendmail, SMTP relay, etc.)
MAIL_ENABLED=false
MAIL_FROM=noreply@tudominio.com
MAIL_FROM_NAME=Dewoc Admin
